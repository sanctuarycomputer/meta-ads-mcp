{
  "name": "@byadsco/meta-ads-mcp",
  "version": "4.0.0",
  "description": "MCP server for Meta Ads (Facebook/Instagram) management - agency multi-account",
  "author": {
    "name": "Santiago Bastidas",
    "email": "dev@byads.co",
    "url": "https://byads.co"
  },
  "contributors": [
    {
      "name": "ByAds",
      "url": "https://byads.co"
    }
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "dist/index.js",
  "bin": {
    "meta-ads-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "prepublishOnly": "npm run build && npm test",
    "start": "node dist/index.js --transport stdio",
    "start:stdio": "node dist/index.js --transport stdio",
    "dev": "tsx src/index.ts --transport stdio",
    "dev:stdio": "tsx src/index.ts --transport stdio",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pino": "^9.6.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "^2.0.5"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "meta",
    "meta-ads",
    "meta-marketing-api",
    "facebook",
    "facebook-ads",
    "facebook-ads-api",
    "facebook-marketing-api",
    "instagram",
    "instagram-ads",
    "ads",
    "advertising",
    "marketing",
    "marketing-api",
    "campaigns",
    "agency",
    "multi-tenant",
    "claude",
    "anthropic",
    "ai-agent",
    "openai",
    "oauth",
    "firestore",
    "cloud-run",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/byadsco/meta-ads-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byadsco/meta-ads-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/byadsco/meta-ads-mcp/issues"
  }
}
